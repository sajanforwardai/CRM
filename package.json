{
  "name": "forwardai-crm",
  "version": "0.1.0",
  "description": "CRM platform for ForwardAI consulting firm",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
